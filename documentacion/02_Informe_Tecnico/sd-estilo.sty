% ---------- Portada ----------
% \sdportada{Tipo de documento}{Título}{Subtítulo}
\newcommand{\sdportada}[3]{%
\begin{titlepage}
\thispagestyle{empty}
\begin{tikzpicture}[remember picture,overlay]
  % Banda lateral
  \fill[sdink] (current page.north west) rectangle ([xshift=1.35cm]current page.south west);
  \shade[top color=sdteal,bottom color=sdblue]
    ([xshift=1.35cm]current page.north west) rectangle ([xshift=1.55cm]current page.south west);
  % Retícula de 32 piezas (dos arcadas de 16), motivo odontográfico discreto
  \foreach \row/\y in {0/4.3,1/3.62}{
    \foreach \i in {0,...,15}{
      \pgfmathsetmacro{\op}{ (\i==7 || \i==8) ? 0.9 : 0.16 + 0.03*abs(7.5-\i) }
      \draw[sdteal,line width=0.7pt,opacity=\op,rounded corners=1.6pt]
        ([xshift=3.05cm+\i*0.92cm,yshift=\y cm]current page.south west) rectangle ++(0.62,0.5);
    }
  }
  \node[anchor=south west,font=\sffamily\scriptsize,text=sdmuted]
    at ([xshift=3.05cm,yshift=2.85cm]current page.south west)
    {Notación FDI · 32 piezas permanentes};
\end{tikzpicture}

\vspace*{-0.4cm}
\hspace*{0.6cm}\begin{minipage}{0.86\textwidth}
{\sffamily\small\color{sdmuted}\MakeUppercase{\sduniversidad}\par}
\vspace{1pt}
{\sffamily\small\color{sdmuted}\sdescuela\par}

\vspace{4.6cm}
{\sffamily\bfseries\small\color{sdteal}\MakeUppercase{#1}\par}
\vspace{0.45cm}
{\sffamily\bfseries\fontsize{46}{50}\selectfont\color{sdink}#2\par}
\vspace{0.45cm}
{\rmfamily\Large\color{sdmuted}\begin{minipage}{0.92\linewidth}\raggedright #3\end{minipage}\par}
\vspace{0.9cm}
{\color{sdteal}\rule{2.4cm}{2.2pt}}

\vspace{0.9cm}
{\sffamily\small
\begin{tabular}{@{}p{3.1cm}l@{}}
\textcolor{sdmuted}{Asignatura} & \textbf{\sdcurso} \\
\textcolor{sdmuted}{Actividad}  & \sdactividad \\
\textcolor{sdmuted}{Semana}     & 8 \\
\textcolor{sdmuted}{Modalidad}  & Individual \\[0.5em]
\textcolor{sdmuted}{Autor}      & \textbf{\sdautor} \\
\textcolor{sdmuted}{Fecha}      & \sdfecha \\
\end{tabular}\par}
\end{minipage}
\end{titlepage}
}

% ---------- Cajas ----------
\newtcolorbox{sdnota}[1][Nota]{enhanced,breakable,colback=sdsoft,colframe=sdsoft,
  borderline west={2.4pt}{0pt}{sdteal},arc=2pt,left=10pt,right=10pt,top=6pt,bottom=6pt,
  fonttitle=\sffamily\bfseries\small,coltitle=sdteal,title={#1},attach title to upper={\par\vspace{2pt}},
  fontupper=\small}
\newtcolorbox{sdaviso}[1][Importante]{enhanced,breakable,colback=sdamber!7,colframe=sdamber!7,
  borderline west={2.4pt}{0pt}{sdamber},arc=2pt,left=10pt,right=10pt,top=6pt,bottom=6pt,
  fonttitle=\sffamily\bfseries\small,coltitle=sdamber!80!black,title={#1},attach title to upper={\par\vspace{2pt}},
  fontupper=\small}
\newtcolorbox{sdpaso}[1]{enhanced,breakable,colback=white,colframe=sdline,boxrule=0.6pt,arc=3pt,
  left=10pt,right=10pt,top=7pt,bottom=7pt,fonttitle=\sffamily\bfseries\small,colbacktitle=sdsoft,
  coltitle=sdink,title={#1},fontupper=\small}

% Captura de pantalla con marco fino
\newcommand{\captura}[3][0.96\linewidth]{%
  \begin{figure}[H]\centering
  \begin{tikzpicture}
    \IfFileExists{#2.jpg}
      {\node[inner sep=0pt] (img) {\includegraphics[width=#1]{#2}};}
      {\node[inner sep=0pt,minimum width=#1,minimum height=0.56*#1,fill=sdsoft,font=\sffamily\small,text=sdmuted] (img) {Captura pendiente: \detokenize{#2}};}
    \draw[sdline,line width=0.7pt,rounded corners=3pt] (img.south west) rectangle (img.north east);
  \end{tikzpicture}
  \caption{#3}\label{fig:#2}
  \end{figure}}

% Tecla o elemento de interfaz
\newcommand{\boton}[1]{\tikz[baseline=(b.base)]\node[draw=sdline,fill=sdsoft,rounded corners=2pt,inner xsep=4pt,inner ysep=1.5pt,font=\sffamily\footnotesize](b){#1};}
\newcommand{\ruta}[1]{\textsf{\small\color{sdteal}#1}}
\newcommand{\codigo}[1]{\texttt{\small #1}}

