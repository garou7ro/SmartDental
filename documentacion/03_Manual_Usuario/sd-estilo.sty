\color{sdink}

% ---------- Utilidades ----------
\RequirePackage{graphicx}
\RequirePackage{booktabs,tabularx,longtable,array,multirow}
\RequirePackage{enumitem}
\RequirePackage{amsmath,amssymb}
\RequirePackage{float}
\RequirePackage{calc}
\RequirePackage{multicol}
\RequirePackage{needspace}
\RequirePackage{tikz}
\usetikzlibrary{positioning,arrows.meta,shapes.geometric,fit,calc,backgrounds,shadows.blur}
\RequirePackage[most]{tcolorbox}
\RequirePackage{csquotes}
\RequirePackage{titlesec,titletoc}
\RequirePackage[font={small,sf},labelfont={bf,color=sdteal},labelsep=period,justification=raggedright,singlelinecheck=false,skip=6pt]{caption}

\setlist{itemsep=0.22em,topsep=0.3em,leftmargin=1.4em}
\setlist[itemize]{label={\color{sdteal}\small$\blacktriangleright$}}
\renewcommand{\arraystretch}{1.3}
\newcolumntype{L}{>{\raggedright\arraybackslash}X}
\newcolumntype{P}[1]{>{\raggedright\arraybackslash}p{#1}}
\newcolumntype{C}[1]{>{\centering\arraybackslash}p{#1}}

% ---------- Títulos ----------
\titleformat{\section}[display]
  {\sffamily\bfseries\color{sdink}}
  {\small\color{sdteal}\MakeUppercase{Capítulo}~\thesection}{0.25em}
  {\fontsize{24}{28}\selectfont}[\vspace{4pt}{\color{sdline}\titlerule[0.8pt]}]
\titleformat{\subsection}
  {\sffamily\bfseries\Large\color{sdink}}{\color{sdteal}\thesubsection}{0.6em}{}
\titleformat{\subsubsection}
  {\sffamily\bfseries\large\color{sdink}}{\thesubsubsection}{0.5em}{}
\titleformat{\paragraph}[runin]
  {\sffamily\bfseries\color{sdink}}{}{0pt}{}
\titlespacing*{\section}{0pt}{0.2em}{1.1em}
\titlespacing*{\subsection}{0pt}{1.3em}{0.45em}
\titlespacing*{\subsubsection}{0pt}{1em}{0.3em}
\newcommand{\capitulo}[1]{\clearpage\section{#1}}

% ---------- Página sin encabezados ni pies: solo el número ----------
\RequirePackage{fancyhdr}
\fancypagestyle{sdpagina}{\fancyhf{}\renewcommand{\headrulewidth}{0pt}\renewcommand{\footrulewidth}{0pt}%
  \fancyfoot[C]{\sffamily\footnotesize\color{sdmuted}\thepage}}
\pagestyle{sdpagina}
\fancypagestyle{plain}{\fancyhf{}\renewcommand{\headrulewidth}{0pt}\fancyfoot[C]{\sffamily\footnotesize\color{sdmuted}\thepage}}

% ---------- Índices ----------
\titlecontents{section}[0em]{\vspace{0.5em}\sffamily\bfseries}
  {\contentslabel[\color{sdteal}\thecontentslabel]{1.8em}}{}{\hfill\contentspage}
\titlecontents{subsection}[1.8em]{\sffamily\small}
  {\contentslabel[\thecontentslabel]{2.4em}}{}{\titlerule*[0.6pc]{.}\contentspage}
\titlecontents{figure}[0em]{\sffamily\small}
  {\contentslabel[\color{sdteal}\thecontentslabel]{2.2em}}{}{\titlerule*[0.6pc]{.}\contentspage}
\titlecontents{table}[0em]{\sffamily\small}
  {\contentslabel[\color{sdteal}\thecontentslabel]{2.2em}}{}{\titlerule*[0.6pc]{.}\contentspage}

% ---------- Portada (sin datos personales) ----------
\newcommand{\sdportada}{%
\begin{titlepage}
\thispagestyle{empty}
\begin{tikzpicture}[remember picture,overlay]
  \fill[sdink] (current page.north west) rectangle (current page.south east);
  \shade[left color=sdteal,right color=sdblue,opacity=0.9]
    ([yshift=-0.5cm]current page.north west) rectangle ([yshift=-0.72cm]current page.north east);
  % Arcada estilizada: 16 piezas superiores y 16 inferiores
  \begin{scope}[shift={([xshift=-5.6cm,yshift=-9.4cm]current page.north east)}]
    \foreach \i in {0,...,15}{
      \pgfmathsetmacro{\a}{180-\i*12-0.0}
      \pgfmathsetmacro{\op}{(\i==2 || \i==9) ? 1 : 0.35}
      \ifnum\i=2 \def\c{sdred}\else\ifnum\i=9 \def\c{sdblue}\else\def\c{white}\fi\fi
      \draw[\c,line width=1pt,opacity=\op,rounded corners=2pt,fill=\c,fill opacity=0.08*\op]
        ({4.1*cos(\a+6)},{3.3*sin(\a+6)}) ++(-0.33,-0.27) rectangle ++(0.66,0.54);
    }
    \foreach \i in {0,...,15}{
      \pgfmathsetmacro{\a}{180+\i*12}
      \ifnum\i=12 \def\c{sdred}\def\op{1}\else\def\c{white}\def\op{0.22}\fi
      \draw[\c,line width=1pt,opacity=\op,rounded corners=2pt]
        ({4.1*cos(\a+6)},{3.3*sin(\a+6)-1.2}) ++(-0.33,-0.27) rectangle ++(0.66,0.54);
    }
  \end{scope}
  \node[anchor=south west,font=\sffamily\scriptsize,text=white!55!sdink,align=left]
    at ([xshift=2.2cm,yshift=1.6cm]current page.south west)
    {Versión 1.0 del sistema\\Noviembre de 2026};
\end{tikzpicture}

