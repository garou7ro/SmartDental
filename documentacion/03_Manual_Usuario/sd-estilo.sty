\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{sd-estilo}[2026/11/05 Estilo del manual de usuario SmartDental]

% ---------- Idioma y tipografía ----------
\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
\RequirePackage[spanish,es-noshorthands,es-tabla]{babel}
\RequirePackage[default,semibold]{sourceserifpro}
\RequirePackage[scale=0.92]{sourcesanspro}
\RequirePackage[scale=0.86]{sourcecodepro}
\RequirePackage{microtype}
\RequirePackage{fontawesome5}

% ---------- Página ----------
\RequirePackage[a4paper,top=2.3cm,bottom=2.4cm,left=2.4cm,right=2.4cm]{geometry}
\RequirePackage{setspace}
\setstretch{1.15}
\setlength{\parindent}{0pt}
\setlength{\parskip}{0.6em}
\RequirePackage{ragged2e}

% ---------- Color ----------
\RequirePackage[table,dvipsnames]{xcolor}
\definecolor{sdink}{HTML}{14202E}
\definecolor{sdmuted}{HTML}{5B6676}
\definecolor{sdline}{HTML}{D9DFE7}
\definecolor{sdsoft}{HTML}{F3F6F9}
\definecolor{sdteal}{HTML}{0E8C80}
\definecolor{sdblue}{HTML}{1F5FBF}
\definecolor{sdred}{HTML}{C0392B}
\definecolor{sdamber}{HTML}{B7791F}
\definecolor{sdviolet}{HTML}{6B5CF6}
