% ---------- Avisos con icono ----------
\newcommand{\sdavisobox}[5]{% nombre, color, icono, título por omisión
\newtcolorbox{#1}[1][#4]{enhanced,colback=#2!6,colframe=#2!6,
  borderline west={2.6pt}{0pt}{#2},arc=2pt,left=30pt,right=10pt,top=7pt,bottom=7pt,
  fontupper=\small,
  overlay={\node[anchor=north west,text=#2,font=\normalsize] at ([xshift=9pt,yshift=-7pt]frame.north west) {\faIcon{#3}};},
  before upper={{\sffamily\bfseries\small\color{#2!85!black}##1}\par\vspace{2pt}}#5}}
\sdavisobox{sdnota}{sdteal}{info-circle}{Nota}{}
\sdavisobox{sdconsejo}{sdblue}{lightbulb}{Consejo}{}
\sdavisobox{sdaviso}{sdamber}{exclamation-triangle}{Importante}{}
\sdavisobox{sdpermiso}{sdviolet}{lock}{Permisos}{}
\sdavisobox{sdpeligro}{sdred}{ban}{Precaución}{}

% Caja de paso del ejemplo práctico
\newtcolorbox{sdpaso}[1]{enhanced,breakable,colback=white,colframe=sdline,boxrule=0.6pt,arc=3pt,
  left=10pt,right=10pt,top=7pt,bottom=7pt,fonttitle=\sffamily\bfseries\small,colbacktitle=sdsoft,
  coltitle=sdink,title={#1},fontupper=\small}

% ---------- Señalización sobre capturas ----------
% \begin{pantalla}[ancho]{archivo}{ancho en px de la captura}{pie de figura}
%   \zona{n}{x}{y}{w}{h}  recuadro + marcador n en su esquina superior izquierda (px)
%   \zonad{n}{x}{y}{w}{h} igual, con el marcador en la esquina superior derecha
%   \pin{n}{x}{y}         solo el marcador, centrado en (x, y)
% \end{pantalla}
\tikzset{
  sdpin/.style={circle,fill=sdpin,draw=white,line width=1.3pt,text=white,font=\sffamily\bfseries\footnotesize,
    inner sep=0pt,minimum size=1.35em,blur shadow={shadow blur steps=6,shadow xshift=0.4pt,shadow yshift=-0.6pt,shadow opacity=35}},
  sdzona/.style={draw=sdpin,line width=1.1pt,rounded corners=3pt,fill=sdpin,fill opacity=0.07},
}
\newsavebox\sdimgbox
\newcommand{\sdcapt}{}\newcommand{\sdlab}{}
\newenvironment{pantalla}[4][\linewidth]{%
  \sbox\sdimgbox{\includegraphics[width=#1]{capturas/#2}}%
  \begin{figure}[H]\centering
  \pgfmathsetmacro\sdpx{\wd\sdimgbox/#3}%
  \gdef\sdcapt{#4}\gdef\sdlab{#2}%
  \begin{tikzpicture}[x=\sdpx pt,y=-\sdpx pt]
  \node[anchor=north west,inner sep=0pt] (img) at (0,0) {\usebox\sdimgbox};
}{%
  \draw[sdline,line width=0.7pt,rounded corners=3pt] (img.south west) rectangle (img.north east);
  \end{tikzpicture}
  \caption{\sdcapt}\label{fig:\sdlab}
  \end{figure}}
\newcommand{\zona}[5]{\draw[sdzona] (#2,#3) rectangle ++(#4,#5); \node[sdpin] at (#2,#3) {#1};}
\newcommand{\zonad}[5]{\draw[sdzona] (#2,#3) rectangle ++(#4,#5); \node[sdpin] at ($(#2,#3)+(#4,0)$) {#1};}
\newcommand{\pin}[3]{\node[sdpin] at (#2,#3) {#1};}

% Marcador en el texto, idéntico al de la captura
\newcommand{\marca}[1]{\tikz[baseline=(m.base)]\node[circle,fill=sdpin,text=white,font=\sffamily\bfseries\scriptsize,inner sep=0pt,minimum size=1.3em](m){#1};}

% Leyenda numerada bajo cada captura
\newenvironment{leyenda}[1][2]{%
  \par\nopagebreak[4]\vspace{-0.4em}\nopagebreak[4]\small\noindent\begin{minipage}{\linewidth}
  \begin{multicols}{#1}\raggedcolumns
  \begin{list}{}{\leftmargin=2em\labelwidth=1.5em\labelsep=0.5em\itemsep=0.35em\topsep=0pt\parsep=0pt}}
  {\end{list}\end{multicols}\end{minipage}\par\vspace{0.2em}}
\newcommand{\li}[2]{\item[\marca{#1}]\textbf{#2.}~}

% ---------- Accesos por rol ----------
\newcommand{\sdchip}[2]{\tikz[baseline=(c.base)]\node[rounded corners=6pt,inner xsep=6pt,inner ysep=2.2pt,font=\sffamily\scriptsize\bfseries,#1](c){#2};}
\newcommand{\rolsi}[1]{\sdchip{fill=sdteal!12,text=sdteal!80!black}{\faIcon{check}\enspace#1}}
\newcommand{\rolno}[1]{\sdchip{draw=sdline,text=sdmuted!80}{\faIcon{times}\enspace#1}}
\newcommand{\rolver}[1]{\sdchip{fill=sdamber!12,text=sdamber!85!black}{\faIcon{eye}\enspace#1}}
% \acceso{A}{O}{R}  con s = sí, n = no, v = solo consulta
\newcommand{\sdrol}[2]{\if#1s\rolsi{#2}\else\if#1v\rolver{#2}\else\rolno{#2}\fi\fi}
\newcommand{\acceso}[3]{\par\noindent{\sffamily\scriptsize\color{sdmuted}\MakeUppercase{Disponible para}}\enspace
  \sdrol{#1}{Administración}\enspace\sdrol{#2}{Odontólogo}\enspace\sdrol{#3}{Recepción}\par\medskip}
\newcommand{\soloplataforma}{\par\noindent{\sffamily\scriptsize\color{sdmuted}\MakeUppercase{Disponible para}}\enspace\rolsi{Administración de plataforma}\par\medskip}

% ---------- Pasos numerados ----------
\newcounter{sdpasos}
\newenvironment{pasos}{\setcounter{sdpasos}{0}\begin{list}{}{\leftmargin=2.1em\labelwidth=1.6em\labelsep=0.5em\itemsep=0.35em\topsep=0.3em}}{\end{list}}
\newcommand{\paso}{\stepcounter{sdpasos}\item[{\tikz[baseline=(n.base)]\node[circle,fill=sdink,text=white,font=\sffamily\scriptsize\bfseries,inner sep=1.6pt,minimum size=1.15em](n){\thesdpasos};}]}
\newcommand{\resultado}[1]{\par{\small\color{sdteal}\faIcon{check-circle}\enspace\textit{#1}}\par}

% ---------- Elementos de interfaz ----------
\newcommand{\boton}[1]{\tikz[baseline=(b.base)]\node[draw=sdline,fill=sdsoft,rounded corners=2pt,inner xsep=4pt,inner ysep=1.5pt,font=\sffamily\footnotesize](b){\strut #1};}
\newcommand{\tecla}[1]{\tikz[baseline=(b.base)]\node[draw=sdmuted!60,fill=white,rounded corners=2pt,inner xsep=3.5pt,inner ysep=1.2pt,font=\ttfamily\footnotesize,blur shadow={shadow blur steps=3,shadow xshift=0pt,shadow yshift=-0.5pt,shadow opacity=25}](b){\strut #1};}
\newcommand{\ruta}[1]{\textsf{\small\color{sdteal}#1}}
\newcommand{\sep}{\,\faIcon{angle-right}\,}
\newcommand{\campo}[1]{\textsf{\small\itshape #1}}
\newcommand{\codigo}[1]{\texttt{\small #1}}
\newcommand{\estado}[2]{\tikz[baseline=(e.base)]\node[rounded corners=2pt,fill=#1!14,text=#1!80!black,font=\sffamily\scriptsize\bfseries,inner xsep=4pt,inner ysep=1.6pt](e){\strut #2};}

